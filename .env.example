APP_NAME="Package Pipeline"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Seconds before the queue treats a job as abandoned and gives it to another
# worker. Must stay above the longest job timeout (300s, for a version import
# streaming a large archive) or slow imports run twice at once. Only raise it.
# DB_QUEUE_RETRY_AFTER=330

# Disk for the cached Composer zipballs. Defaults to FILESYSTEM_DISK; set to
# "s3" on any deployment whose containers do not share a local disk.
# DIST_DISK=s3

# Largest artifact zip POST /upload/{vendor}/{package} accepts, in megabytes.
# Raise it for vendored monorepo builds — PHP's own upload_max_filesize and
# post_max_size have to allow the same size, or PHP drops the body first.
# ARTIFACT_UPLOAD_MAX_MB=100

# How long a rendered /p2 metadata payload is kept, and the largest one worth
# storing. Entries are keyed by a fingerprint of the versions behind them, so
# they supersede themselves; the lifetime only bounds the leftovers, and the
# ceiling keeps a huge payload out of the cache store rather than out of the
# response. Set the ceiling to 0 to serve every payload straight from the rows.
# METADATA_CACHE_DAYS=7
# METADATA_CACHE_MAX_KB=4096

# Upstream mirroring. Nothing here turns it on — that is a per-repository
# decision, made by adding an upstream in the admin panel, and an installation
# with none never reaches any of this. See docs/mirroring.md.
#
# How long since it was last *served* a cached upstream document or archive
# survives `mirror:prune`. Nothing else ever deletes one, so this is the only
# bound on what the mirror costs in disk, and the number to lower when disk is
# tight. Measured on use rather than age: a package every build installs is
# never evicted, one pulled in by a spike leaves. A pruned entry costs one
# upstream fetch the next time it is wanted.
# MIRROR_RETENTION_DAYS=30

# How long a cached document is served without asking the upstream anything.
# Past it the next request revalidates with If-None-Match / If-Modified-Since,
# which for an unchanged package is a 304 with no body — so this trades
# staleness against a round trip, not against bandwidth.
# MIRROR_METADATA_TTL_MINUTES=60

# The same for a name the upstream does not have. Much shorter, because a
# package published a minute ago is the one somebody is waiting on — but never
# zero, or a typo in a composer.json costs a request on every resolve.
# MIRROR_MISSING_TTL_MINUTES=10

# How long an upstream's `composer audit` answer is reused. An audit runs
# inside every `composer update`, so without this a CI fleet puts one upstream
# request per build in front of a feed that is itself hours old.
# MIRROR_ADVISORY_TTL_MINUTES=10

# How long an upstream that has just failed is left alone. Cached documents
# still answer during it and nothing reaches the network. Without it an outage
# costs every mirrored lookup a connect timeout, holding a PHP worker for each.
# MIRROR_FAILURE_BACKOFF_MINUTES=5

# Ceilings on what will be cached from an upstream. ARTIFACT_UPLOAD_MAX_MB
# above bounds what one of your own tokens may spend; these bound what a
# stranger's published package can, since any name a consuming project
# requires can reach them.
# MIRROR_MAX_ARCHIVE_MB=256
# MIRROR_MAX_METADATA_KB=8192

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Cloud injects these into the environment when an object storage
# bucket is attached to the app, so they only need filling in locally or on
# another host. AWS_ENDPOINT and AWS_URL stay empty on S3 proper; other
# S3-compatible providers need both.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Registers this registry with GitHub, which is what lets an admin connect an
# organisation from the admin panel in a click. Both values come off the app's
# settings page when it is created; see docs/github-app.md.
# GITHUB_APP_PRIVATE_KEY takes either a path to the generated .pem or the key
# itself with its newlines escaped as "\n".
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# The secret set on the app's webhook, which is what turns auto-sync on: with
# it, a tag or branch pushed to any connected repository syncs that package
# straight away. Set the same value here and on the app; see docs/webhooks.md.
GITHUB_APP_WEBHOOK_SECRET=

# Read from GitHub automatically. Set only to skip that lookup, or if the app
# is renamed. GITHUB_APP_API_URL only changes on GitHub Enterprise.
# GITHUB_APP_SLUG=
# GITHUB_APP_API_URL=https://api.github.com

# Last-resort token, used only for packages with neither a connected source nor
# a token of their own. Leave empty once sources are set up.
GITHUB_TOKEN=

# Where releases and failed syncs are announced, on top of the admin panel's
# own notification bell. Both are needed; leave them empty to skip Slack.
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# A Prometheus scrape endpoint at /metrics — registry totals, sync health,
# queue depth, and what the mirror cache is holding. Off by default because a
# Composer registry is routinely published to the internet, where these numbers
# describe the installation to anyone who asks; while it is off, /metrics is a
# 404. METRICS_TOKEN, when set, is a bearer token every scrape must present —
# leave it empty only if the path genuinely is not reachable from outside.
# See docs/metrics.md.
METRICS_ENABLED=false
METRICS_TOKEN=
